CS1;
// preset-version: 4
// ChatSphere preset: original rounded style (the built-in look)
theme "Original Preset" version 1;

styles {
    uiCornerStyle: rounded;
    bubbleCornerRadius: 4;
    messageLineSpacing: 0;
    sidebarWidth: 100px;
    avatarRadius: 0;
    blurIntensity: 100%;
    popupBorder: 1;
}
