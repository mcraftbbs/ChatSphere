CS1;
// ChatSphere preset: pixel corners (pixel-art style)
theme "Pixel Preset" version 1;

dark {
    screenBg: #1A1A2E;
    sidebarBg: #14142A;
    panelBg: #242446;
    panelBg2: #1E1E3A;
    popupBg: #202042;
    popupBg2: #1E1E3E;
    popupBg3: #18182E;
    searchBg: #14142E;
    inputBg: #44111122;
    notifGradTop: #CC1A1A3E;
    notifGradBot: #CC2A2A4E;
    replyBarBg: #CC2E2E50;
    toolbarBg: #88000000;
    previewSwatchBg: #FF38384A;
    popupOutline: #77FFFFFF;
    popupOutline2: #99FFFFFF;
    emojiOutline: #55FFFFFF;
    itemPickerOutline: #55FFFFFF;
    divider: #22FFFFFF;
    accentLine: #88FFFFFF;
    sectionLine: #66FFFFFF;
    scrollThumb: #90FFFFFF;
    scrollTrack: #33FFFFFF;
    accent: #FF55DDE0;
    hoverRow: #2233DDCC;
    activeRow: #5533DDCC;
    menuHover: #44DDDDCC;
    iconBtnBg: #44000000;
    iconBtnHover: #5533DDCC;
    searchCloseBg: #22FFFFFF;
    emojiCellBg: #4466AA88;
    emojiTabBg: #22000000;
    emojiTabHover: #443366AA;
    emojiTabSel: #6655AA88;
    slotBg: #44000000;
    slotHover: #5533DDCC;
    text: #FFFFFFFF;
    textMain: #FFCCCCCC;
    textDim: #FF888888;
    textFaint: #FF555555;
    textInactive: #FFAAAAAA;
    floatingText: #FFFFFFFF;
    floatingTextDim: #99FFFFFF;
    inputText: #FFE0E0E0;
    searchPlaceholder: #FF666666;
    bubbleOwn: #FF1D3B5C;
    bubbleOther: #FF26262E;
    bubbleInfoLine: #FF555555;
    cmdBubbleOwn: #FF2D2D2D;
    cmdBubbleOther: #FF1E1E2E;
    toggleOn: #FF2E7D4F;
    toggleOff: #FF3A3A4A;
    toggleKnob: #FFF0F0F0;
}

light {
    screenBg: #F0F0F5;
    sidebarBg: #E6E6F0;
    panelBg: #F2F2FA;
    panelBg2: #EEEEF8;
    popupBg: #F4F4FC;
    popupBg2: #F0F0F8;
    popupBg3: #F0F0F6;
    searchBg: #FFFFFFFF;
    inputBg: #33000000;
    notifGradTop: #CCE0E0EA;
    notifGradBot: #CCEAEAF4;
    replyBarBg: #CCE4E4EE;
    toolbarBg: #88000000;
    previewSwatchBg: #FFDDDDE8;
    popupOutline: #66000000;
    popupOutline2: #88000000;
    emojiOutline: #55000000;
    itemPickerOutline: #55000000;
    divider: #33000000;
    accentLine: #88000000;
    sectionLine: #44000000;
    scrollThumb: #90AAAAEE;
    scrollTrack: #30888888;
    accent: #FF33B8BB;
    hoverRow: #33AADDCC;
    activeRow: #66AADDCC;
    menuHover: #44DDDDCC;
    iconBtnBg: #22FFFFFF;
    iconBtnHover: #55AADDCC;
    searchCloseBg: #44AAAAAA;
    emojiCellBg: #4488CCAA;
    emojiTabBg: #22FFFFFF;
    emojiTabHover: #44AAAAFF;
    emojiTabSel: #6688CCAA;
    slotBg: #22FFFFFF;
    slotHover: #55AADDCC;
    text: #FF1A1A1A;
    textMain: #FF333333;
    textDim: #FF666666;
    textFaint: #FF888888;
    textInactive: #FF666666;
    floatingText: #FF1A1A1A;
    floatingTextDim: #991A1A1A;
    inputText: #FFE0E0E0;
    searchPlaceholder: #FF888888;
    bubbleOwn: #FFD9E8FF;
    bubbleOther: #FFFFFFFF;
    bubbleInfoLine: #FF888888;
    cmdBubbleOwn: #FF2D2D2D;
    cmdBubbleOther: #FF1E1E2E;
    toggleOn: #FF3BA55D;
    toggleOff: #FFB8B8C4;
    toggleKnob: #FFFFFFFF;
}

styles {
    uiCornerStyle: pixel;
    bubbleCornerRadius: 4;
    messageLineSpacing: 2px;
    sidebarWidth: 100px;
    avatarRadius: 3px;
    blurIntensity: 100%;
}
